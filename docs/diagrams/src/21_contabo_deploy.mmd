    WL[worker-light 1.5 GB] --> RD
    WT[worker-train 3.5 GB, concurrency 1] --> RD
    BT[lab-beat hourly maintenance]
    MF[mlflow optional]
  end
  DJ --> CD
  USR[Browser] --> VC[Vercel - Next.js frontend]
