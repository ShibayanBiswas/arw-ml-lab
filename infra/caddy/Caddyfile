{
  email {$ACME_EMAIL}
}
{$LAB_API_HOSTNAME} {
  encode zstd gzip
  request_body {
    max_size 60MB
  }
  reverse_proxy lab-api:8000 {
    flush_interval -1
    health_uri /healthz
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  log {
    output stdout
    format json
  }
}
