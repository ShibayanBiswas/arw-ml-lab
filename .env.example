# ARW ML Lab — environment variables (docs/ARCHITECTURE.md §39.10)
# Copy to .env for local development. Never commit .env. Columns below show where each variable is set.
#   [V] Vercel (frontend)  [A] Render lab-api  [W] Render workers  [G] GitHub Actions secrets  [L] local

# ---------- Frontend (Vercel) — only NEXT_PUBLIC_* reach the browser ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321          # [V][L]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                           # [V][L] publishable/anon key only
NEXT_PUBLIC_LAB_API_URL=http://localhost:8000            # [V][L]

# ---------- Supabase (backend) ----------
SUPABASE_URL=http://127.0.0.1:54321                      # [A][W][L]
SUPABASE_SERVICE_ROLE_KEY=                               # [A][W][L] secret — backend only
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json   # [A][L]
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres     # [A][L] pooler (transaction mode) in prod
DATABASE_URL_SESSION=postgresql://postgres:postgres@127.0.0.1:54322/postgres  # [W][L] session/direct in prod
SUPABASE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3  # [A][W][L]
SUPABASE_S3_REGION=local                                 # [A][W][L]
SUPABASE_S3_ACCESS_KEY_ID=                               # [A][W][L]
SUPABASE_S3_SECRET_ACCESS_KEY=                           # [A][W][L]
STORAGE_BUCKET_DATASETS=datasets                         # [A][W][L]
STORAGE_BUCKET_ARTEFACTS=artefacts
STORAGE_BUCKET_MODELS=models
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_PLOTS=plots
STORAGE_BUCKET_PREDICTIONS=predictions                   # [A][W][L] §45

# ---------- Broker / API ----------
REDIS_URL=redis://localhost:6379/0                       # [A][W][L] Render Key Value in prod
CORS_ALLOWED_ORIGINS=http://localhost:3000               # [A][L] add Vercel prod + preview domains in prod

# ---------- Auth (BFF) — JWT_SECRET must be identical on Vercel + Contabo lab-api ----------
AUTH_MODE=bff                                            # [A][V][L] bff = HS256 from Next.js; supabase = JWKS
JWT_SECRET=dev-jwt-secret-change-me                      # [A][V][L] same value in Vercel env and /opt/arw-ml-lab/.env
AUTH_TEST_BYPASS=false                                   # [A][L] true only in unit tests

# ---------- Hosted AI (docs/ARCHITECTURE.md §40) — BACKEND ONLY, never in Vercel ----------
AI_ENABLED=true                                          # [A][W][L] false → numbers-only mode
AI_PROVIDER_PRIMARY=nvidia                               # [A][W][L]
AI_BASE_URL=https://integrate.api.nvidia.com/v1          # [A][W][L]
NVIDIA_API_KEY=                                          # [A][W][L] secret from build.nvidia.com (trial key: dev/test use)
AI_VISION_CHAIN=nvidia/nemotron-3.5-super-vl-120b-a12b,google/gemma-4-31b-it,meta/llama-3.2-90b-vision-instruct
AI_VISION_FAST_CHAIN=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,google/gemma-4-31b-it
AI_TEXT_CHAIN=nvidia/nemotron-3-super-120b-a12b,deepseek-ai/deepseek-v4.1-flash,openai/gpt-oss-20b
AI_TEXT_DEEP_CHAIN=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
AI_RPM_LIMIT=35                                          # stay under ~40 RPM observed on free keys
AI_DAILY_REQUEST_CAP=500                                 # per workspace
AI_USER_DAILY_REQUEST_CAP=150
AI_IMAGE_MAX_B64_BYTES=170000                            # NVIDIA inline image limit is 180 KB (base64)
# Optional fallback providers (disabled unless an admin enables them)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ---------- Lab settings ----------
LAB_DEFAULT_SEED=42                                      # [A][W][L]
# Phase 0 local UI without Supabase Auth (never set in production)
LAB_AUTH_BYPASS=false                                    # [L]
AUTH_TEST_BYPASS=false                                   # [L] unit tests only
LAB_MAX_ROWS=2000000                                         # Contabo §12 default; raise only after load tests
LAB_JOB_SOFT_LIMIT_TRAIN_MIN=90
LAB_JOB_HARD_LIMIT_TRAIN_MIN=120
# Prediction Studio (docs/ARCHITECTURE.md §45.8)
LAB_PREDICT_MAX_MB=50                                    # [A][W][L]
LAB_PREDICT_MAX_ROWS=1000000                             # [A][W][L]
LAB_PREDICT_CHUNK_ROWS=50000                             # [W][L]
LAB_PREDICT_RETENTION_DAYS=30                            # [W][L]
TABPFN_ENABLED=false                                     # non-commercial weights for v2.5+; keep false
TABPFN_TOKEN=
MLFLOW_TRACKING_URI=                                     # optional
OPTUNA_STORAGE_URL=                                      # [A][W][L] Optuna RDB (e.g. postgresql+psycopg://…); empty = in-memory
SENTRY_DSN=                                              # [A][W] optional (backend)
NEXT_PUBLIC_SENTRY_DSN=                                  # [V] optional (browser DSN is public by design; scrub PII in beforeSend)
SENTRY_ENVIRONMENT=development                           # [V][A][W]
HEALTHCHECK_PING_URL=                                    # [W] optional Contabo §11 lab-beat → healthchecks.io ping after maintenance

# ---------- CI/CD only (GitHub Actions secrets, not in .env) ----------
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, SUPABASE_PROJECT_ID          [G]
# RENDER_DEPLOY_HOOK_API, RENDER_DEPLOY_HOOK_WORKER_LIGHT, RENDER_DEPLOY_HOOK_WORKER_TRAIN   [G]
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID                            [G] only if not using Vercel Git integration
# LAB_API_URL (GitHub Actions *variable*, not secret: public lab-api URL for the deploy smoke test)  [G]
